NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:password@localhost:5432/restaurant_platform
SEED_ADMIN_EMAIL=admin@restaurant.local
SEED_ADMIN_PASSWORD=Password123@
SEED_CUSTOMER_EMAIL=customer@restaurant.local
# Falls back to SEED_ADMIN_PASSWORD when left empty.
SEED_CUSTOMER_PASSWORD=Password123@
CLIENT_URL=http://localhost:3000
# Storefront origins allowed by CORS/CSRF: the platform apex + all its subdomains,
# and verified custom storefront hostnames (comma-separated).
PLATFORM_DOMAIN=
CUSTOM_DOMAINS=
# Proxy hops in front of the API whose X-Forwarded-For is trusted. Set to 1 when a
# load balancer/CDN that appends the client IP sits in front of the web app.
TRUST_PROXY_HOPS=0
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600

# Use log locally to print email links in the API terminal. Production requires smtp.
MAIL_MODE=log
MAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=

# Shared upload provider: cloudinary or local.
UPLOAD_STORAGE_PROVIDER=cloudinary
UPLOAD_LOCAL_DIR=uploads
UPLOAD_PUBLIC_URL=http://localhost:3001/uploads

# Required when UPLOAD_STORAGE_PROVIDER=cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

HEALTH_DATABASE_TIMEOUT_MS=3000
