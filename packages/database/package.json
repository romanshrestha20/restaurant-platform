{
  "name": "@restaurant/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./src/client.ts",
  "types": "./src/client.ts",
  "exports": {
    ".": "./src/client.ts",
    "./authorization": {
      "types": "./src/authorization.d.cts",
      "default": "./src/authorization.cjs"
    },
    "./connection-url": {
      "types": "./src/connection-url.d.cts",
      "default": "./src/connection-url.cjs"
    },
    "./generated": {
      "types": "./src/generated/index.d.ts",
      "default": "./src/generated/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "deploy": "prisma migrate deploy",
    "seed": "prisma db seed",
    "seed:menu": "tsx prisma/seed-menu.ts",
    "studio": "prisma studio",
    "push": "prisma db push"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcrypt": "^6.0.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "tsx": "^4.23.4"
  }
}
