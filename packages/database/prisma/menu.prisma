enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum MenuItemStatus {
  AVAILABLE
  UNAVAILABLE
  HIDDEN
}

model Menu {
  id String @id @default(cuid())

  restaurantId String

  name        String
  description String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categories Category[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([restaurantId, name])
  @@index([restaurantId, sortOrder])
  @@index([deletedAt])
  @@map("menus")
}

model Category {
  id String @id @default(cuid())

  restaurantId String
  menuId       String

  name        String
  description String?

  sortOrder Int @default(0)

  status CategoryStatus @default(ACTIVE)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menu       Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)

  menuItems MenuItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([menuId, name])
  @@index([restaurantId])
  @@index([menuId, sortOrder])
  @@index([deletedAt])
  @@map("categories")
}

model MenuItem {
  id String @id @default(cuid())

  restaurantId String
  categoryId   String

  name        String
  description String?

  sku String?

  basePrice Decimal @db.Decimal(10, 2)

  preparationTime Int?

  calories Int?

  isFeatured Boolean @default(false)

  sortOrder Int @default(0)

  status MenuItemStatus @default(AVAILABLE)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  media MenuItemMedia[]

  variants Variant[]

  addOnGroups MenuItemAddOnGroup[]

  orderItems OrderItem[]
  cartItems  CartItem[]
  favorites  Favorite[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([restaurantId, sku])
  @@index([restaurantId])
  @@index([restaurantId, status])
  @@index([categoryId])
  @@index([categoryId, status])
  @@index([categoryId, sortOrder])
  @@index([deletedAt])
  @@map("menu_items")
}

model Variant {
  id String @id @default(cuid())

  menuItemId String

  name String

  sortOrder Int @default(0)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  options VariantOption[]

  @@map("variants")
}

model VariantOption {
  id String @id @default(cuid())

  variantId String

  name String

  priceAdjustment Decimal @db.Decimal(10, 2)

  variant Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]
  cartItems  CartItem[]

  @@map("variant_options")
}

model AddOnGroup {
  id String @id @default(cuid())

  restaurantId String

  name String

  required Boolean @default(false)

  minSelection Int @default(0)

  maxSelection Int @default(1)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  addOns AddOn[]

  menuItems MenuItemAddOnGroup[]

  @@index([restaurantId])
  @@map("addon_groups")
}

model AddOn {
  id String @id @default(cuid())

  groupId String

  name String

  price Decimal @db.Decimal(10, 2)

  sortOrder Int @default(0)

  isAvailable Boolean @default(true)

  group AddOnGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  orderItems OrderItemAddOn[]
  cartItems  CartItemAddOn[]

  @@index([groupId, sortOrder])
  @@map("addons")
}

model MenuItemAddOnGroup {
  menuItemId String
  groupId    String

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  group AddOnGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([menuItemId, groupId])
  @@map("menu_item_addon_groups")
}
