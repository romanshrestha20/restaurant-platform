enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  SERVED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum CartStatus {
  ACTIVE
  CHECKED_OUT
  ABANDONED
}

model Cart {
  id String @id @default(cuid())

  userId       String
  restaurantId String

  status CartStatus @default(ACTIVE)

  currency  String   @default("EUR")
  version   Int      @default(1)
  expiresAt DateTime?

  subtotal Decimal @default(0) @db.Decimal(10, 2)
  tax      Decimal @default(0) @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @default(0) @db.Decimal(10, 2)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
  @@index([userId, restaurantId, status])
}

model CartItem {
  id String @id @default(cuid())

  cartId     String
  menuItemId String
  quantity Int

  notes                  String?
  configurationSignature String

  unitPrice Decimal @db.Decimal(10, 2)

  totalPrice Decimal @db.Decimal(10, 2)

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  variantOptions CartItemVariantOption[]

  addOns CartItemAddOn[]

  createdAt DateTime @default(now())

  @@map("cart_items")
  @@index([cartId])
  @@unique([cartId, configurationSignature])
}

model CartItemVariantOption {
  cartItemId String
  optionId   String

  priceAdjustment Decimal @db.Decimal(10, 2)

  cartItem CartItem      @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  option   VariantOption @relation(fields: [optionId], references: [id])

  @@id([cartItemId, optionId])
  @@map("cart_item_variant_options")
}

model CartItemAddOn {
  cartItemId String
  addOnId    String

  quantity Int @default(1)

  price Decimal @db.Decimal(10, 2)

  cartItem CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

  addOn AddOn @relation(fields: [addOnId], references: [id])

  @@id([cartItemId, addOnId])
  @@map("cart_item_addons")
}

model Order {
  id String @id @default(cuid())

  orderNumber String @unique

  userId String

  restaurantId String

  tableId           String?
  deliveryAddressId String?

  type OrderType

  status OrderStatus @default(PENDING)

  notes String?

  subtotal Decimal @db.Decimal(10, 2)

  tax Decimal @db.Decimal(10, 2)

  discount Decimal @db.Decimal(10, 2)
  tip Decimal @default(0) @db.Decimal(10, 2)

  total Decimal @db.Decimal(10, 2)

  restaurantSnapshot Json?

  user User @relation(fields: [userId], references: [id])

  restaurant Restaurant @relation(fields: [restaurantId], references: [id])

  table RestaurantTable? @relation(fields: [tableId], references: [id])

  deliveryAddress Address? @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)

  items OrderItem[]

  payment Payment?

  history OrderStatusHistory[]

  review      Review?
  couponUsage CouponUsage?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
  @@index([deliveryAddressId])
  @@map("orders")
}

model OrderItem {
  id String @id @default(cuid())

  orderId String

  menuItemId String?

  name String

  quantity Int

  unitPrice Decimal @db.Decimal(10, 2)

  totalPrice Decimal @db.Decimal(10, 2)

  itemSnapshot Json?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItem MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)

  variantOptions OrderItemVariantOption[]

  addOns OrderItemAddOn[]

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model OrderItemVariantOption {
  id String @id @default(cuid())

  orderItemId String

  optionId String?

  name String

  variantName String?

  priceAdjustment Decimal @db.Decimal(10, 2)

  orderItem OrderItem      @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  option    VariantOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([optionId])
  @@map("order_item_variant_options")
}

model OrderItemAddOn {
  id String @id @default(cuid())

  orderItemId String

  addOnId String?

  name String

  groupName String?

  quantity Int @default(1)

  price Decimal @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  addOn AddOn? @relation(fields: [addOnId], references: [id], onDelete: SetNull)

  @@index([orderItemId])
  @@index([addOnId])
  @@map("order_item_addons")
}

model OrderStatusHistory {
  id String @id @default(cuid())

  orderId String

  status OrderStatus

  changedById String?

  notes String?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  changedBy User? @relation(fields: [changedById], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}
